# Secrets — never commit real env files.
.env
.env.*
# ...but DO keep the documented template.
!.env.example

# Python
__pycache__/
*.pyc
# Virtualenvs — never commit (incl. the local Moss-verification venv at
# crossexam/.venv). Match at any depth so nested venvs are also ignored.
.venv/
crossexam/.venv/
**/.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Vite
node_modules/
dist/
.vite/
coverage/

# pipeline `make index` artifacts
pipeline/build/

# OS
.DS_Store

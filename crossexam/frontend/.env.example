# CrossExam frontend environment.
# Leave these BLANK to run in mock mode (the demo works fully offline with no backend).

# LiveKit server WebSocket URL, e.g. wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=

# Short-lived access token for the LiveKit room (issued by the backend token endpoint).
VITE_LIVEKIT_TOKEN=

# Force mock mode regardless of the above (true/false). Defaults to mock when URL/token are absent.
VITE_MOCK_MODE=

# PDF the canvas renders. The pipeline generates a real, multi-page mock
# deposition into public/sample-deposition.pdf whose key lines sit at the SAME
# coordinates the backend fixture cites. Regenerate with:
#   cd ../pipeline && python -m crossexam_pipeline.make_sample_pdf
# Set to a different URL to render another document; falls back to a placeholder on failure.
VITE_PDF_URL=/sample-deposition.pdf

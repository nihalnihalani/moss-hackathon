# =============================================================================
# CrossExam — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# CrossExam runs FULLY in mock mode with NO secrets: leave the Moss/LiveKit
# values blank and the backend auto-falls-back to an in-process mock index
# (see `crossexam_backend/config.py` -> `_resolve_use_mocks`). The frontend
# likewise defaults to mock mode when VITE_LIVEKIT_URL/TOKEN are absent.
# =============================================================================

# -----------------------------------------------------------------------------
# Moss — sub-10ms in-process semantic retrieval (BACKEND + PIPELINE)
# Both ID and KEY must be set to use the real Moss client; otherwise mocks.
# -----------------------------------------------------------------------------
MOSS_PROJECT_ID=
# Single key used by BOTH the backend (query) and the pipeline (upsert).
MOSS_PROJECT_KEY=
# Name of the Moss index to query / build. Has a sane default if unset.
MOSS_INDEX_NAME=crossexam-documents
# Optional API base-URL override (defaults to the Moss cloud endpoint).
# MOSS_BASE_URL=

# -----------------------------------------------------------------------------
# LiveKit — real-time voice transport (BACKEND worker + FRONTEND)
# All three are required for a live voice session. Blank => mock/offline demo.
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Unsiloed — PDF Parse/Extract for the offline pipeline (PIPELINE)
# Required only when running `crossexam-pipeline parse` against the real API.
# `parse --dry-run` and the test-suite need no key.
# -----------------------------------------------------------------------------
UNSILOED_API_KEY=
# Optional API base-URL override (defaults to the Unsiloed prod endpoint).
# UNSILOED_BASE_URL=

# -----------------------------------------------------------------------------
# Voice pipeline: STT / LLM / TTS providers (BACKEND, OPTIONAL)
# Only needed for a LIVE (non-mock) voice session. The worker builds the
# AgentSession(stt=..., llm=..., tts=...) from these. Each provider needs its
# matching API key below and the optional plugin deps:
#   pip install 'crossexam-backend[voice]'
# Defaults: deepgram (STT) / openai (LLM) / cartesia (TTS).
# -----------------------------------------------------------------------------
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia

# Provider API keys (required for the matching provider above in live mode):
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# -----------------------------------------------------------------------------
# Alternative voice providers (BACKEND, OPTIONAL — not wired by default)
# -----------------------------------------------------------------------------
# MiniMax (Nova-style voice):
MINIMAX_API_KEY=
# ...or AWS Bedrock / Nova:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Retrieval tuning (BACKEND, OPTIONAL — sane defaults baked in)
# -----------------------------------------------------------------------------
# TOP_K=5            # citations retrieved per turn (1-50)
# ALPHA=0.8          # hybrid weight: 1.0 = pure semantic, 0.0 = pure keyword
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Mock / runtime switch (BACKEND)
# Leave UNSET for auto-detection (mock when Moss keys missing).
#   USE_MOCKS=true   -> FORCE mock mode even when keys are present (demo/offline).
#   USE_MOCKS=false  -> FORCE the REAL path. Set this to go fully live; the
#                       backend then expects real Moss + provider keys and will
#                       report MISSING in `make verify-live` if any are absent.
# For "drop in keys -> it's fully real", set USE_MOCKS=false and fill the keys
# above (Moss + LiveKit + voice providers). See KEYS.md for the exact list.
# -----------------------------------------------------------------------------
USE_MOCKS=

# -----------------------------------------------------------------------------
# HTTP API service (BACKEND — `crossexam-api` / python -m crossexam_backend.api)
# The FastAPI service the browser talks to: mints LiveKit tokens (POST /token),
# ingests uploaded PDFs (POST /documents), and reports readiness (GET /healthz,
# GET /config). Needs the [api] extra:  pip install '.[api,voice]'.
# All values below have working local-dev defaults; override only as needed.
# -----------------------------------------------------------------------------
# Host/port the API binds to. 0.0.0.0 is intended for the dev/container service.
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed by CORS (the Vite dev server / SPA).
CORS_ORIGINS=http://localhost:5173
# TTL (seconds) for minted LiveKit access tokens (60–86400).
TOKEN_TTL_SECONDS=3600
# Max accepted upload size for POST /documents, in megabytes (1–200).
MAX_UPLOAD_MB=25
# Default LiveKit room a /token request joins when the body omits `room`.
LIVEKIT_DEFAULT_ROOM=crossexam

# -----------------------------------------------------------------------------
# Frontend (Vite) — these are baked into the static build at `npm run build`.
# Must be prefixed VITE_ to be exposed to the browser. Blank => mock UI.
# -----------------------------------------------------------------------------
# Base URL of the HTTP API service above (token + upload + config endpoints).
# Default matches API_HOST/API_PORT on localhost.
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=
# Short-lived LiveKit room access token (issued by a backend token endpoint).
VITE_LIVEKIT_TOKEN=
# URL of the PDF the viewer renders (served statically or via CDN).
VITE_PDF_URL=
# Force the frontend into mock mode regardless of the above (true/false).
VITE_MOCK_MODE=
